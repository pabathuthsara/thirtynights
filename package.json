{
  "name": "thirtynights",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "node --stack_size=8192 node_modules/typescript/bin/tsc --noEmit",
    "test": "vitest run",
    "worker:check": "npm run check --prefix worker",
    "doctor": "npx expo-doctor",
    "export:web": "expo export --platform web",
    "db:start": "supabase start",
    "db:verify": "supabase db reset && supabase db lint --local --level error --fail-on error && supabase test db",
    "db:stop": "supabase stop --no-backup",
    "audit:release": "npm audit --audit-level=high && npm audit --prefix worker --omit=dev --audit-level=high",
    "check": "npm run typecheck && npm test && npm run worker:check && npm run export:web"
  },
  "dependencies": {
    "@expo-google-fonts/dm-mono": "0.4.2",
    "@expo-google-fonts/fraunces": "0.4.1",
    "@expo/metro-runtime": "57.0.8",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "2.111.0",
    "expo": "~57.0.10",
    "expo-apple-authentication": "57.0.1",
    "expo-asset": "57.0.8",
    "expo-audio": "57.0.3",
    "expo-auth-session": "~57.0.6",
    "expo-constants": "~57.0.9",
    "expo-crypto": "57.0.1",
    "expo-dev-client": "57.0.10",
    "expo-file-system": "57.0.1",
    "expo-font": "57.0.1",
    "expo-haptics": "57.0.1",
    "expo-linear-gradient": "57.0.1",
    "expo-localization": "57.0.1",
    "expo-network": "57.0.1",
    "expo-notifications": "57.0.8",
    "expo-secure-store": "57.0.1",
    "expo-sharing": "57.0.8",
    "expo-splash-screen": "~57.0.5",
    "expo-sqlite": "57.0.1",
    "expo-status-bar": "57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "57.0.2",
    "fflate": "0.8.3",
    "lucide-react-native": "1.28.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-purchases": "10.6.0",
    "react-native-safe-area-context": "5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "4.0.0",
    "react-native-web": "0.21.2",
    "tus-js-client": "4.3.1"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/react": "19.2.4",
    "supabase": "2.111.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
