DATABASE_URL=postgresql://worker-role:password@database-host:5432/postgres?sslmode=require
SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=enter-in-host-secret-manager
OPENAI_API_KEY=enter-in-host-secret-manager
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe-diarize
# VERIFY BEFORE DEPLOYING. GPT-5.6 ships as tiers (Sol/Terra/Luna) and the bare
# "gpt-5.6" string may not resolve to an API model ID. Check what your account
# can actually call:
#   curl https://api.openai.com/v1/models -H "Authorization: Bearer $OPENAI_API_KEY"
# A wrong ID fails at report_analysis_404 — the worker keeps polling and reports
# simply never arrive, which looks like slowness rather than an outage.
# This workload is strict-schema extraction over transcripts, not open-ended
# reasoning; the mid or cheap tier is the sensible default, not the flagship.
OPENAI_REPORT_MODEL=gpt-5.6
REPORT_PROMPT_VERSION=2026-08-v1
REPORT_SCHEMA_VERSION=v1
WORKER_POLL_MS=5000
FFMPEG_PATH=ffmpeg
# Liveness endpoint. Most hosts inject PORT themselves; WORKER_HEALTH_PORT is
# the fallback. Probe GET /healthz.
WORKER_HEALTH_PORT=8080
# Upstream deadlines, in milliseconds. Unbounded, a hung provider holds a job
# lease for its full thirty minutes and stalls everything queued behind it.
STORAGE_TIMEOUT_MS=120000
TRANSCRIPTION_TIMEOUT_MS=300000
ANALYSIS_TIMEOUT_MS=300000
