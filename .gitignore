node_modules/
.expo/
dist/
web-build/
.DS_Store
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Native projects are generated by prebuild (CNG) from app.config.ts. Checking
# them in makes EAS Build ignore `orientation`, `scheme`, `userInterfaceStyle`,
# `icon`, `backgroundColor`, `ios`, `android` and `plugins` from the config —
# which silently ships the wrong package name, deep-link scheme, permission
# strings and splash screen. Let `npx expo prebuild` regenerate them per profile.
android/
ios/

# Secrets. `.env` itself was previously tracked; real provider keys belong in
# the EAS environment or the provider's own secret manager, never in Git.
.env
.env.local
.env.*.local
*.jks
*.p8
*.p12
*.key
*.mobileprovision
supabase/.temp/

# Working scratch, local captures and tool output.
tmp/
.impeccable/
